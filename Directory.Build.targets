<Project>
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)build\$(ModId)\</OutDir>
    <DeployPath>$(TerrariaPath)\TerrariaModder\mods</DeployPath>
  </PropertyGroup>

  <!-- Copy manifest.json and icon.png (if present) into the mod's build folder. -->
  <Target Name="CopyMetadata" AfterTargets="Build">
    <ItemGroup>
      <_ModMetadata Include="$(MSBuildProjectDirectory)\manifest.json" />
      <_ModMetadata
        Include="$(MSBuildProjectDirectory)\icon.png"
        Condition="Exists('$(MSBuildProjectDirectory)\icon.png')"
      />
    </ItemGroup>
    <Copy SourceFiles="@(_ModMetadata)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Deploy the built mod to the TerrariaModder installation. -->
  <Target
    Name="DeployToGame"
    AfterTargets="CopyMetadata"
    Condition="'$(DeployToGame)' == 'true' and (Exists('$(DeployPath)\$(ModId)') or '$(DeployAbsent)' == 'true')"
  >
    <ItemGroup>
      <_ModOutputFiles Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_ModOutputFiles)"
      DestinationFolder="$(DeployPath)\$(ModId)"
      SkipUnchangedFiles="true"
    />
  </Target>
</Project>
